# Copy this file to .env.production and replace every example-only value.
# Never commit .env.production. Compose reads it both for interpolation and as
# the application env file.

# Compose / public edge
CHESS_LAB_IMAGE=ghcr.io/roman2050/chess-lab:v0.1.0
APP_VERSION=0.1.0
APP_DOMAIN=api.example.com
ACME_EMAIL=operator@example.com
PROXY_SUBNET=172.30.0.0/24
CADDY_PROXY_IPV4=172.30.0.2
API_PROXY_IPV4=172.30.0.3
ANALYSIS_WORKER_CONCURRENCY=1
REPORTS_WORKER_CONCURRENCY=1

# Runtime logs: one JSON record per stdout line. Compose sets LOG_SERVICE for
# each API/worker role, so it does not belong in this shared file.
APP_ENVIRONMENT=production
LOG_LEVEL=INFO

# PostgreSQL (internal service DNS; password must be generated for production)
DB_HOST=db
DB_PORT=5432
DB_USER=chess_lab
DB_PASSWORD=replace-with-a-generated-database-password
DB_NAME=chess_lab

# Redis / Celery (internal service DNS)
redis_url=redis://redis:6379/0

# Public discovery and browser access
DEMO_PLAYER_NAME=DemoPlayer
CORS_ALLOWED_ORIGINS=
FRONTEND_DEPLOYMENT_ENABLED=false

# Single-operator write access (generate at least 32 random characters)
MVP_API_KEY=replace-with-a-generated-operator-key-at-least-32-characters

# Lichess application identity and safety bounds
LICHESS_USER_AGENT=ChessLab/0.1 (+mailto:operator@example.com)
LICHESS_API_TOKEN=
LICHESS_TOTAL_TIMEOUT_SECONDS=30
LICHESS_MIN_COOLDOWN_SECONDS=60
LICHESS_MAX_COOLDOWN_SECONDS=3600
LICHESS_MAX_RESPONSE_BYTES=5242880

# Per-request operation budgets
MAX_ANALYSIS_TASKS_PER_REQUEST=10
MAX_UPLOAD_GAMES=100
MVP_RATE_LIMIT_WINDOW_SECONDS=3600
MVP_LICHESS_IMPORTS_PER_WINDOW=5
MVP_UPLOADS_PER_WINDOW=10
MVP_ANALYSIS_REQUESTS_PER_WINDOW=20
MVP_REPORT_REQUESTS_PER_WINDOW=5

# Stockfish — the production image contains this exact binary
STOCKFISH_PATH=/usr/local/bin/stockfish
STOCKFISH_DEPTH=20
STOCKFISH_MULTIPV=2
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# External OpenAI-compatible LLM provider; do not use host-local Ollama on VPS
LLM_BASE_URL=https://llm-provider.example/v1
LLM_MODEL=replace-with-provider-model
LLM_API_KEY=replace-with-the-provider-key
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=120

# Report generation
REPORT_LANGUAGE=en
REPORT_ALLOWED_LANGUAGES=en,uk
REPORT_REFRESH_THRESHOLD=20
REPORT_GENERATION_LEASE_SECONDS=900
