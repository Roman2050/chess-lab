{
	email {$ACME_EMAIL}

	servers {
		timeouts {
			read_body 2m
			read_header 10s
			write 2m
			idle 5m
		}
		max_header_size 32KB
	}
}

{$APP_DOMAIN} {
	log {
		output stdout
		format json
	}

	# The application accepts files up to 20 MiB. The proxy allowance includes
	# multipart framing while still rejecting unbounded request bodies.
	request_body {
		max_size 24MB
	}

	encode zstd gzip

	header {
		-Server
	}

	reverse_proxy api:8000 {
		transport http {
			dial_timeout 5s
			response_header_timeout 2m
		}
	}
}
