# Copy to .env and adjust. The app loads these at import time (app/config.py).

# ── Database (matches docker-compose `db` service) ────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=chess
DB_PASSWORD=chess
DB_NAME=chess_lab

# ── Celery / Redis ───────────────────────────────────────────────────────────
redis_url=redis://localhost:6379/0

# ── Single-operator write access ─────────────────────────────────────────────
# Required. Generate a fresh key, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# Store the generated value in environment/hosting secret storage; never commit it.
MVP_API_KEY=

# ── Lichess application client ───────────────────────────────────────────────
# Required. Identify this deployed application and provide a real public contact
# URL or email so Lichess can reach the operator if the integration misbehaves.
LICHESS_USER_AGENT=ChessLab/0.1 (+https://your-real-contact.example)
# Optional server-side OAuth token. Public game export works without it.
LICHESS_API_TOKEN=
LICHESS_TOTAL_TIMEOUT_SECONDS=30
# Hard cap for the decoded upstream response body (5 MiB).
LICHESS_MAX_RESPONSE_BYTES=5242880

# ── Per-request operation budgets ────────────────────────────────────────────
MAX_ANALYSIS_TASKS_PER_REQUEST=10
MAX_UPLOAD_GAMES=100

# ── Redis quotas for expensive POST operations ──────────────────────────────
MVP_RATE_LIMIT_WINDOW_SECONDS=3600
MVP_LICHESS_IMPORTS_PER_WINDOW=5
MVP_UPLOADS_PER_WINDOW=10
# Single-game and batch analysis intentionally share this budget.
MVP_ANALYSIS_REQUESTS_PER_WINDOW=20
MVP_REPORT_REQUESTS_PER_WINDOW=5

# ── Stockfish (analysis tasks no-op when STOCKFISH_PATH is unset) ─────────────
STOCKFISH_PATH=
STOCKFISH_DEPTH=20
STOCKFISH_MULTIPV=2
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=128

# ── LLM (Phase 5) — any OpenAI-compatible endpoint; switch models here ────────
# Defaults target a local Ollama instance (`ollama pull llama3.1`).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=120

# ── Report (Phase 5) ─────────────────────────────────────────────────────────
REPORT_LANGUAGE=en
REPORT_ALLOWED_LANGUAGES=en,uk
REPORT_REFRESH_THRESHOLD=20
# A report stuck in `generating` (worker killed) is reclaimable after this many
# seconds. Keep it well above LLM_TIMEOUT.
REPORT_GENERATION_LEASE_SECONDS=900
